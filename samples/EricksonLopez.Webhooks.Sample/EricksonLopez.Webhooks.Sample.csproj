<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EricksonLopez.Webhooks\EricksonLopez.Webhooks.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Webhooks.AspNetCore\EricksonLopez.Webhooks.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Webhooks.Redis\EricksonLopez.Webhooks.Redis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
