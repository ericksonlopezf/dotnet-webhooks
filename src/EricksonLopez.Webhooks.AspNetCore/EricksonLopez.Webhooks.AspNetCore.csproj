<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.Webhooks.AspNetCore</AssemblyName>
    <RootNamespace>EricksonLopez.Webhooks.AspNetCore</RootNamespace>
    <PackageId>EricksonLopez.Webhooks.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for receiving and cryptographically verifying inbound webhooks. Protects against replay attacks, enforces HMAC-SHA256 signature verification, and integrates with Minimal APIs and Controllers.</Description>
    <PackageTags>$(CommonPackageTags);webhook;webhook-receiver;inbound;aspnetcore;middleware;minimal-apis;hmac-sha256;signature-verification;anti-replay;secret-rotation;standard-webhooks;native-aot</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>


  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Webhooks\EricksonLopez.Webhooks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Webhooks.AspNetCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- Prevent CS0757 duplicate partial method implementations from Microsoft.Gen.Logging on .NET 8/9 where SDK generator is active -->
  <Target Name="RemoveDuplicateLoggingGenerator" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net9.0'">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(FileName)' == 'Microsoft.Gen.Logging'" />
    </ItemGroup>
  </Target>

</Project>
